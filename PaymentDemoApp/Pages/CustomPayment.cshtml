@page "/custom-payment"
@model PaymentDemoApp.Pages.CustomPaymentModel

<body data-publishable-key="@Model.PublishableKey">

    <h2>Payment</h2>

    <form id="payment-form">
        <label for="name">Name</label>
        <input id="name" type="text" required />

        <label for="email">Email</label>
        <input id="email" type="email" required />

        <label for="country">Country</label>
        <select id="country" required>
            <option value="RS">Serbia</option>
            <option value="US">United States</option>
            <option value="GB">United Kingdom</option>
            <option value="CA">Canada</option>
            <option value="AU">Australia</option>
            <option value="DE">Germany</option>
            <option value="FR">France</option>
        </select>

        <label>Card Number</label>
        <div id="card-number-element" class="stripe-input"></div>

        <label>Expiration Date</label>
        <div id="card-exp-element" class="stripe-input"></div>

        <label>CVC</label>
        <div id="card-cvc-element" class="stripe-input"></div>

        <button id="submit">Pay</button>

        <div id="payment-result"></div>
    </form>

    @section Scripts {
        <script src="https://js.stripe.com/v3/"></script>
        <script src="~/js/custom-payment.js"></script>
    }

    <link rel="stylesheet" href="~/css/custom-payment.css" />
</body>
